# GitHub (required for ingest)
GITHUB_TOKEN=

# Target repo (owner/name)
GRAFT_REPO=

# Local artifact root (repo-scoped paths live under data/repos/<owner>/<name>/)
DATA_DIR=./data

# Compile / retrieval
GRAFT_MIN_SUPPORT=2

# Privacy / determinism: LLM off by default
GRAFT_LLM_ENABLED=false

# Optional LLM keys (only used when GRAFT_LLM_ENABLED=true)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional Postgres (file mode is the MVP default)
# DATABASE_URL=
